# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径（相对项目根目录，按需改为绝对路径）
MODELSCOPE_CACHE=./models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=./models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/
# 模型根目录 / 其他缓存根目录（未配置时默认 <项目根>/models、<项目根>/.cache）
# MODELS_DIR=./models
# CACHE_DIR=./.cache
# PyTorch / tiktoken / sentence-transformers 等缓存默认也会写入上述目录，无需单独配置
# TORCH_HOME=./.cache/torch
# TIKTOKEN_CACHE_DIR=./.cache/tiktoken

# ====================
# Local Directory (输入 / 输出路径)
# ====================
# 上传文档的根目录，默认 <项目根>/doc
DATA_BASED_ROOT_DIR=./doc
# 解析产物（md/json/图片）根目录，默认 <项目根>/output
OUTPUT_DIR=./output

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=qwen3-vl-flash
# 商品名识别模型
ITEM_MODEL=qwen-flash

# ====================
# Reranker API（百炼原生接口）
# ====================
# 百炼 API Key，与对话模型的 OPENAI_API_KEY 独立
TEXT_RERANK_API_KEY=
# 原生 API 地址
TEXT_RERANK_API_BASE=https://dashscope.aliyuncs.com/api/v1
# 重排序模型
TEXT_RERANK_MODEL=qwen3-rerank
# 排序任务指令（留空使用模型默认指令）
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落
# 单次请求超时（秒）
TEXT_RERANK_TIMEOUT=60

# ====================
# Embedding API（百炼原生接口，返回稠密和稀疏向量）
# ====================
# 百炼 API Key，与对话模型的 OPENAI_API_KEY 独立
EMBEDDING_API_KEY=
# 原生 API 地址（不要使用 compatible-mode/v1）
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/api/v1
# 嵌入模型
EMBEDDING_MODEL=text-embedding-v4
# 向量维度，与现有 Milvus 集合保持一致
EMBEDDING_DIM=1024
# 单次请求超时（秒）
EMBEDDING_TIMEOUT=60

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://localhost:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://localhost:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=localhost:9000
# 访问密钥
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
