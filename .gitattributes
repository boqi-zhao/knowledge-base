# 统一换行符规则（macOS / Linux 开发环境）
# - 仓库内与工作区一律使用 LF
# - git 自动识别二进制文件，不做转换
* text=auto eol=lf

# 明确标记二进制文件，避免被误判为文本而损坏
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.whl  binary
*.so   binary
*.dylib binary

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 依赖锁文件
uv.lock text eol=lf
